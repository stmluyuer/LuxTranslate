  "Entry": "index.js",
  "Icon": "relative:images/app.svg",
  "SupportedOS": ["windows", "linux", "darwin"],
  "Features": [
    {
      "Name": "ai"
    },
    {
      "Name": "debounce",
      "Params": {
        "IntervalMs": 300
      }
    }
  ],
  "SettingDefinitions": [
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:settings_group_basic",
        "Style": {}
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "default_provider",
        "Label": "i18n:settings_provider",
        "Tooltip": "i18n:settings_provider_tip",
        "DefaultValue": "microsoft",
        "Options": [
          { "Label": "i18n:provider_microsoft", "Value": "microsoft" },
          { "Label": "i18n:provider_deepl", "Value": "deepl" },
          { "Label": "i18n:provider_wox_ai", "Value": "wox_ai" },
          { "Label": "i18n:provider_openai", "Value": "openai_compatible" }
        ],
        "Style": { "Width": 320 }
      }
    },
    {
      "Type": "table",
      "Value": {
        "Key": "provider_table",
        "Title": "i18n:settings_provider_table",
        "Tooltip": "i18n:settings_provider_table_tip",
        "DefaultValue": "[{\"enabled\":false,\"name\":\"Microsoft\",\"provider\":\"microsoft\",\"note\":\"No setup\"},{\"enabled\":false,\"name\":\"DeepL\",\"provider\":\"deepl\",\"note\":\"Needs API key\"},{\"enabled\":false,\"name\":\"Wox AI\",\"provider\":\"wox_ai\",\"note\":\"Uses Wox AI\"},{\"enabled\":false,\"name\":\"OpenAI compatible\",\"provider\":\"openai_compatible\",\"note\":\"Needs API key\"}]",
        "SortColumnKey": "name",
        "SortOrder": "asc",
        "MaxHeight": 260,
        "Columns": [
          { "Key": "enabled", "Label": "i18n:table_enabled", "Type": "checkbox", "Width": 70 },
          { "Key": "name", "Label": "i18n:table_name", "Type": "text", "Width": 150 },
          {
            "Key": "provider",
            "Label": "i18n:table_provider",
            "Type": "select",
            "Width": 180,
            "SelectOptions": [
              { "Label": "i18n:provider_microsoft", "Value": "microsoft" },
              { "Label": "i18n:provider_deepl", "Value": "deepl" },
              { "Label": "i18n:provider_wox_ai", "Value": "wox_ai" },
              { "Label": "i18n:provider_openai", "Value": "openai_compatible" }
            ]
          },
          { "Key": "note", "Label": "i18n:table_note", "Type": "text", "Width": 240 }
        ],
        "Style": { "Width": 720 }
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "default_source_language",
        "Label": "i18n:settings_source",
        "Tooltip": "i18n:settings_source_tip",
        "DefaultValue": "auto",
        "Options": [
          { "Label": "Auto", "Value": "auto" },
          { "Label": "English", "Value": "en" },
          { "Label": "Chinese", "Value": "zh" }
        ],
        "Style": { "Width": 320 }
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "default_target_policy",
        "Label": "i18n:settings_target_policy",
        "Tooltip": "i18n:settings_target_policy_tip",
        "DefaultValue": "auto_zh_en",
        "Options": [{ "Label": "i18n:target_auto", "Value": "auto_zh_en" }],
        "Style": { "Width": 320 }
      }
    },
    {
      "Type": "newline",
      "Value": { "Style": {} }
    },
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:settings_group_display",
        "Style": {}
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "show_preview_details",
        "Label": "i18n:settings_show_preview_details",
        "Tooltip": "i18n:settings_show_preview_details_tip",
        "DefaultValue": "true",
        "Style": { "Width": 320 }
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "history_limit",
        "Label": "i18n:settings_history_limit",
        "Tooltip": "i18n:settings_history_limit_tip",
        "DefaultValue": "10",
        "Suffix": "items",
        "MaxLines": 1,
        "Validators": [{ "Type": "is_number", "Value": { "IsInteger": true, "IsFloat": false } }],
        "Style": { "Width": 220 }
      }
    },
    {
      "Type": "newline",
      "Value": { "Style": {} }
    },
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:settings_group_deepl",
        "Style": {}
      }
    },
    {
      "Type": "select",
      "Value": {
        "Key": "deepl_plan",
        "Label": "i18n:settings_deepl_plan",
        "DefaultValue": "free",
        "Options": [
          { "Label": "Free", "Value": "free" },
          { "Label": "Pro", "Value": "pro" }
        ],
        "Style": { "Width": 220 }
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "deepl_api_key",
        "Label": "i18n:settings_deepl_key",
        "DefaultValue": "",
        "MaxLines": 1,
        "Style": { "Width": 500 }
      }
    },
    {
      "Type": "newline",
      "Value": { "Style": {} }
    },
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:settings_group_wox_ai",
        "Style": {}
      }
    },
    {
      "Type": "selectAIModel",
      "Value": {
        "Key": "wox_ai_model",
        "Label": "i18n:settings_wox_ai_model",
        "Tooltip": "i18n:settings_wox_ai_model_tip",
        "DefaultValue": "",
        "Style": { "Width": 500 }
      }
    },
    {
      "Type": "newline",
      "Value": { "Style": {} }
    },
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:settings_group_openai",
        "Style": {}
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_base_url",
        "Label": "i18n:settings_openai_base_url",
        "DefaultValue": "https://api.openai.com/v1",
        "MaxLines": 1,
        "Style": { "Width": 500 }
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_api_key",
        "Label": "i18n:settings_openai_key",
        "DefaultValue": "",
        "MaxLines": 1,
        "Style": { "Width": 500 }
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_model",
        "Label": "i18n:settings_openai_model",
        "DefaultValue": "gpt-4o-mini",
        "MaxLines": 1,
        "Style": { "Width": 320 }
      }
    },
    {
      "Type": "newline",
      "Value": { "Style": {} }
    },
    {
      "Type": "head",
      "Value": {
        "Content": "i18n:settings_group_advanced",
        "Style": {}
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "request_timeout_ms",
        "Label": "i18n:settings_timeout",
        "DefaultValue": "10000",
        "Suffix": "ms",
        "MaxLines": 1,
        "Validators": [{ "Type": "is_number", "Value": { "IsInteger": true, "IsFloat": false } }],
        "Style": { "Width": 220 }
      }
    }
  ]
}
